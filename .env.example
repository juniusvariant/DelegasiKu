# DelegasiKu environment template
# Copy to .env and fill in local values. NEVER commit a real .env.
# Legend: (secret) = sensitive, server-only, from secret manager in deployed envs.
# See delegasiku_docs/CONFIGURATION.md for full reference and per-service needs.

# ---------- Shared ----------
NODE_ENV=development
# Integration mode: DEMO | LIVE_VERIFIER | LIVE_KYC  (see ADR-005, PRD §13.1)
INTEGRATION_MODE=DEMO
# Public base URL of the web app (used to build invitation/proof links)
APP_BASE_URL=http://localhost:3000

# ---------- Data layer ----------
# PostgreSQL 18 (secret: password)
DATABASE_URL=postgresql://delegasiku:delegasiku@localhost:5432/delegasiku
# Valkey 9.1 (cache + BullMQ queue). Use rediss:// for TLS in deployed envs.
VALKEY_URL=redis://localhost:6379

# ---------- api service ----------
API_PORT=8080
API_HOST=0.0.0.0
# (secret) HMAC key for signing the seeded admin session cookie (demo mode, PRD §12.1)
ADMIN_SESSION_SECRET=change-me-local-admin-session-secret
# (secret) Dedicated HMAC key for deriving the NIK subject reference (T4). MUST differ from KYC api_secret.
NIK_HMAC_SECRET=change-me-local-nik-hmac-secret
# Proof-page cache TTL seconds (short; delete-on-write on revoke, ADR-004)
PROOF_CACHE_TTL_SECONDS=15

# ---------- callback service ----------
CALLBACK_PORT=8081
CALLBACK_HOST=0.0.0.0
# Expected e.id tenant/client id for inbound callback matching (not a secret)
EID_CLIENT_ID=

# ---------- worker service ----------
# No HTTP port beyond /healthz; shares DATABASE_URL + VALKEY_URL + NIK_HMAC_SECRET + EID_* below.
WORKER_HEALTH_PORT=8082

# ---------- e.id — Verifier API (LIVE_VERIFIER) ----------
# (secret) Bearer-token client credentials from the competition (PRD §13.1)
EID_VERIFIER_BASE_URL=
EID_VERIFIER_CLIENT_ID=
EID_VERIFIER_CLIENT_SECRET=

# ---------- e.id — KYC Gateway (LIVE_KYC, conditional) ----------
# (secret) base64 api_secret used for HMAC-SHA256 request signing (PRD §13.4)
EID_KYC_BASE_URL=
EID_KYC_CLIENT_ID=
EID_KYC_API_SECRET=
