# DelegasiKu git attributes
# Normalize line endings and mark generated/vendored files for cleaner diffs and stats.

# Auto-detect text files and normalize to LF
* text=auto eol=lf

# Explicit binary types
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text
*.ico binary
*.pdf binary

# Lockfiles: treat as generated (less noisy diffs)
pnpm-lock.yaml -diff linguist-generated=true
package-lock.json -diff linguist-generated=true
yarn.lock -diff linguist-generated=true

# Exported diagram renders are generated from Mermaid source
delegasiku_docs/diagrams/*.svg linguist-generated=true
