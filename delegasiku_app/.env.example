# DelegasiKu Environment Configuration
# Copy to .env and update values for local development

# Database
# Local dev: points at localhost (docker-compose.dev.yml maps 5432)
DATABASE_URL="postgresql://delegasiku:delegasiku-dev@localhost:5432/delegasiku"
# Docker compose (full stack): the password is injected into DATABASE_URL by compose
POSTGRES_PASSWORD="delegasiku-dev"

# Valkey (Redis-compatible cache and queue)
VALKEY_URL="redis://localhost:6379"

# Integration mode (DEMO | LIVE_VERIFIER | LIVE_KYC)
INTEGRATION_MODE="DEMO"

# Application
APP_BASE_URL="http://localhost:3000"
# Public URL the web frontend uses to reach the api (SSR + browser)
PUBLIC_API_BASE_URL="http://localhost:3001"
NODE_ENV="development"
LOG_LEVEL="info"

# Secrets (generate with: openssl rand -base64 32)
ADMIN_SESSION_SECRET="change-me-in-production"
NIK_HMAC_SECRET="change-me-in-production"

# API Service
API_PORT="3001"
API_HOST="0.0.0.0"

# Callback Service
CALLBACK_PORT="3002"
CALLBACK_HOST="0.0.0.0"

# Web Service
WEB_PORT="3000"
WEB_HOST="0.0.0.0"

# Worker
WORKER_CONCURRENCY="5"

# Cache TTL
PROOF_CACHE_TTL_SECONDS="60"

# e.id Verifier API (LIVE_VERIFIER mode)
# Sandbox: https://gateway-sandbox.e.id | Production: https://gateway.e.id
EID_VERIFIER_BASE_URL="https://gateway.e.id"
EID_VERIFIER_CLIENT_ID=""
EID_VERIFIER_CLIENT_SECRET=""
EID_VERIFIER_WEBHOOK_SECRET=""
# Document/verification schema ID the holder must present (create via /verification-schema)
EID_VERIFIER_SCHEMA_ID=""

# e.id KYC Gateway (LIVE_KYC mode)
EID_KYC_BASE_URL="https://kyc-api.sandbox.eid.aadm.com"
EID_KYC_CLIENT_ID=""
EID_KYC_CLIENT_SECRET=""
EID_KYC_HMAC_SECRET=""
EID_KYC_WEBHOOK_SECRET=""
