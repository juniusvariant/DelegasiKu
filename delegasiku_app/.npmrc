# pnpm configuration
auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false

# Disable supply-chain policy checks for development
minimum-release-age=0

# CRITICAL: Allow lifecycle scripts (required for Prisma, esbuild)
# pnpm 11 blocks all scripts by default for security
ignore-scripts=false

# Explicitly allow scripts for these packages
# (Alternative to interactive approve-builds)
allowed-scripts=@prisma/client,@prisma/engines,prisma,esbuild,msgpackr-extract
